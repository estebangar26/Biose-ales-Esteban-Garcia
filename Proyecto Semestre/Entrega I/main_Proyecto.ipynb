    "            print(f\"'{ruta_salida}' está vacío o dañado; se procesa desde cero.\")\n",
    "        \n",
    "    errores = []\n",
    "    pendientes = df_diag[~df_diag['FileName'].astype(str).isin(hechos)]\n",
