   "source": [
    "# =============================================================================\n",
    "# PRUEBAS DE HIPÓTESIS: Shapiro-Wilk, Levene, Kruskal-Wallis y Mann-Whitney (post-hoc)\n",
    "# =============================================================================\n",
    "from itertools import combinations\n",
    "from scipy.stats import shapiro, levene, kruskal, mannwhitneyu\n",
    "\n",
    "NIVEL_SIGNIFICANCIA = 0.05\n",
    "\n",
    "NOMBRES_VARIABLES = {\n",
    "    'fMP':  'Frecuencia de Máxima Potencia (fMP)',\n",
    "    'sFSB': 'Suma de Frecuencias Significativas del Biespectro (sFSB)',\n",
    "}\n",
    "\n",
    "\n",
    "def holm(pvals):\n",
    "    \"\"\"Corrección de Holm para comparaciones múltiples (controla el error tipo I global).\"\"\"\n",
    "    p = np.asarray(pvals, dtype=float)\n",
    "    orden = np.argsort(p)\n",
    "    m = len(p)\n",
    "    ajustados = np.empty(m)\n",
    "    previo = 0.0\n",
    "    for rango, i in enumerate(orden):\n",
    "        previo = max(previo, min(1.0, (m - rango) * p[i]))\n",
    "        ajustados[i] = previo\n",
    "    return ajustados\n",
    "\n",
    "\n",
    "def cliff_delta(a, b):\n",
    "    \"\"\"Tamaño de efecto de Mann-Whitney: P(a>b) - P(a<b). Va de -1 a 1.\"\"\"\n",
    "    u = mannwhitneyu(a, b, alternative='two-sided').statistic\n",
    "    return 2 * u / (len(a) * len(b)) - 1\n",
    "\n",
    "\n",
    "def magnitud_cliff(d):\n",
    "    d = abs(d)\n",
    "    return ('despreciable' if d < 0.147 else 'pequeño' if d < 0.33\n",
    "            else 'moderado' if d < 0.474 else 'grande')\n",
    "\n",
    "\n",
    "def analizar_variable(df, variable, grupo='Estado', ritmos=None):\n",
    "    nombre = NOMBRES_VARIABLES.get(variable, variable)\n",
    "    ritmos = ritmos or sorted(df[grupo].unique())\n",
    "    datos = {r: df.loc[df[grupo] == r, variable].dropna().to_numpy(float) for r in ritmos}\n",
    "\n",
    "    # ---- 1. Normalidad (Shapiro-Wilk) por grupo -----------------------------------\n",
    "    print(f\"\\n--- PRUEBA DE NORMALIDAD (Shapiro-Wilk) PARA {variable} ---\")\n",
    "    for r, x in datos.items():\n",
    "        if len(x) >= 3:\n",
    "            muestra = np.random.default_rng(42).choice(x, min(len(x), 500), replace=False)\n",
    "            w, p = shapiro(muestra)\n",
    "            print(f\"Ritmo: {r:8s} | n = {len(x):5d} | W = {w:.4f} | p = {p:.4e} -> \"\n",
    "                  f\"{'No Normal' if p < NIVEL_SIGNIFICANCIA else 'Normal'}\")\n",
    "\n",
    "    # ---- 2. Homogeneidad de varianzas (Levene, versión Brown-Forsythe) ------------\n",
    "    # center='median' es la versión robusta, recomendada cuando los datos no son normales.\n",
    "    grupos = [x for x in datos.values() if len(x) >= 3]\n",
    "    stat_lev, p_lev = levene(*grupos, center='median')\n",
    "    print(\"\\n==============================================================================\")\n",
    "    print(f\"PRUEBA DE LEVENE (homogeneidad de varianzas) - {variable}\")\n",
    "    print(\"==============================================================================\")\n",
    "    print(f\"Estadístico W de Levene: {stat_lev:.4f}\")\n",
    "    print(f\"p-valor:                 {p_lev:.4e}\")\n",
    "    if p_lev < NIVEL_SIGNIFICANCIA:\n",
    "        print(\"Conclusión: Se rechaza H0 (p < 0.05). Las varianzas NO son homogéneas entre ritmos: \"\n",
    "              \"la dispersión de la variable cambia según el tipo de arritmia.\")\n",
    "    else:\n",
    "        print(\"Conclusión: No se rechaza H0 (p >= 0.05). No hay evidencia de que las varianzas \"\n",
    "              \"difieran entre ritmos.\")\n",
    "\n",
    "    # ---- 3. Kruskal-Wallis (comparación global) -----------------------------------\n",
    "    h, p_kw = kruskal(*grupos)\n",
    "    n_total = sum(len(g) for g in grupos)\n",
    "    epsilon2 = h / (n_total - 1)\n",
    "    print(\"\\n==============================================================================\")\n",
    "    print(f\"RESULTADOS DE LA PRUEBA DE HIPÓTESIS (Kruskal-Wallis - {variable})\")\n",
    "    print(\"==============================================================================\")\n",
    "    print(f\"Estadístico H de Kruskal-Wallis: {h:.4f}\")\n",
    "    print(f\"p-valor:                        {p_kw:.4e}\" + (\"  (< 1e-300, por debajo de la precisión numérica)\" if p_kw == 0 else \"\"))\n",
    "    print(f\"Tamaño del efecto (ε²):         {epsilon2:.4f}\")\n",
    "    if p_kw < NIVEL_SIGNIFICANCIA:\n",
    "        print(f\"\\nConclusión: Se rechaza H0 (p < 0.05). Existe una diferencia estadísticamente \"\n",
    "              f\"significativa en la {nombre} entre al menos dos tipos de arritmias.\")\n",
    "    else:\n",
    "        print(f\"\\nConclusión: No se rechaza H0 (p >= 0.05). No hay evidencia suficiente para \"\n",
    "              f\"afirmar diferencias en {variable} entre los tipos de arritmias.\")\n",
    "\n",
    "    # ---- 4. Mann-Whitney por pares (post-hoc) con corrección de Holm --------------\n",
    "    # Solo tiene sentido si el Kruskal-Wallis global fue significativo.\n",
    "    if p_kw >= NIVEL_SIGNIFICANCIA:\n",
    "        return None\n",
    "    filas = []\n",
    "    for a, b in combinations(datos.keys(), 2):\n",
    "        xa, xb = datos[a], datos[b]\n",
    "        if len(xa) < 3 or len(xb) < 3:\n",
    "            continue\n",
    "        u, p = mannwhitneyu(xa, xb, alternative='two-sided')\n",
    "        d = cliff_delta(xa, xb)\n",
    "        filas.append({'Ritmo A': a, 'Ritmo B': b,\n",
    "                      'Mediana A': np.median(xa), 'Mediana B': np.median(xb),\n",
    "                      'U': u, 'p': p, \"δ de Cliff\": d, 'Magnitud': magnitud_cliff(d)})\n",
    "    tabla = pd.DataFrame(filas)\n",
    "    tabla['p Holm'] = holm(tabla['p'])\n",
    "    tabla['¿Significativo?'] = np.where(tabla['p Holm'] < NIVEL_SIGNIFICANCIA, 'Sí', 'No')\n",
    "\n",
    "    n_sig = (tabla['p Holm'] < NIVEL_SIGNIFICANCIA).sum()\n",
    "    print(\"\\n==============================================================================\")\n",
    "    print(f\"MANN-WHITNEY POR PARES (post-hoc, corrección de Holm) - {variable}\")\n",
    "    print(\"==============================================================================\")\n",
    "    print(f\"{n_sig} de {len(tabla)} pares difieren de forma significativa tras la corrección.\")\n",
    "    display(tabla.round({'Mediana A': 3, 'Mediana B': 3, 'U': 0, \"δ de Cliff\": 3}))\n",
    "\n",
    "    # Mapa de calor de p ajustados para ver de un vistazo qué ritmos se parecen\n",
    "    M = pd.DataFrame(np.nan, index=list(datos), columns=list(datos))\n",
